# Copy this file to .env for local development. Both files containing real keys
# and session artifacts are ignored by Git. Never prefix these names with VITE_.
OPENROUTER_API_KEY=
# Default voice: LiveKit Cloud Inference (AssemblyAI STT and Cartesia TTS).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional direct provider plugins or legacy speech transport.
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
CARTESIA_API_KEY=
# LIVEKIT_URL is needed only by applications joining a LiveKit room;
# Studio currently uses LiveKit AgentSession custom PCM/WebSocket IO.

# Public Vercel deployments require visitor keys by default. Enabling shared
# hosted keys is an explicit opt-in. Leave this unset to keep local .env support.
# LIBRETTO_ALLOW_HOSTED_KEYS=true
