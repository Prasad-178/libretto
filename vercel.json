{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "installCommand": "uv sync --active --locked --no-dev --extra studio",
  "buildCommand": "npm --prefix web ci && npm --prefix web run build",
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "includeFiles": "examples/**"
    }
  }
}
